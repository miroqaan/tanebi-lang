# TANEBI 95のシステム構成。起動時にデスクトップがこの出力を読み込みます。
let システム = "TANEBI 95"
let 合言葉 = "一行のコードが、世界に火を灯す。"

print "SYSTEM|" + システム
print "MOTTO|" + 合言葉
print "ICON|computer|TANEBI 95"
print "ICON|studio|TANEBI Studio"
print "ICON|documents|ドキュメント"
print "ICON|recycle|ごみ箱"
print "BOOT|Rustカーネルの境界設計: 参照済み"
print "BOOT|Goホストサービス: 稼働中"
print "BOOT|TANEBIユーザー空間: 起動しました"
