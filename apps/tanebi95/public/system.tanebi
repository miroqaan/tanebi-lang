# TANEBI 95 system profile. The desktop reads this output during boot.
let システム = "TANEBI 95"
let 合言葉 = "一行のコードが、世界に火を灯す。"

print "SYSTEM|" + システム
print "MOTTO|" + 合言葉
print "ICON|computer|TANEBI 95"
print "ICON|studio|TANEBI Studio"
print "ICON|documents|ドキュメント"
print "ICON|recycle|ごみ箱"
print "BOOT|Rust kernel boundary: referenced"
print "BOOT|Go host services: online"
print "BOOT|TANEBI user space: ignited"
